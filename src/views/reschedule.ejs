<!DOCTYPE html>
<html lang="uk">
  <head>
    <meta charset="UTF-8" />
    <title>Reschedule Overdue Tasks</title>
    <link rel="stylesheet" href="/css/index.css" />
  </head>
  <body>
    <main>
      <h1>Reschedule Overdue Tasks</h1>

      <div class="alert-error" id="error-message" hidden></div>

      <form
        id="reschedule-form"
        data-api-url="/api/tasks/reschedule-overdue"
        class="form-card"
      >
        <div class="form-row">
          <label for="maxPerDay" class="form-label">Max tasks per day</label>
          <input
            class="form-input"
            type="number"
            id="maxPerDay"
            name="maxPerDay"
            min="1"
            value="<%= values.maxPerDay %>"
            required
            autofocus
          />
        </div>

        <div class="form-row">
          <label for="windowDays" class="form-label">Planning window (days)</label>
          <input
            class="form-input"
            type="number"
            id="windowDays"
            name="windowDays"
            min="1"
            value="<%= values.windowDays %>"
            required
          />
        </div>

        <div class="form-actions">
          <button class="btn primary" type="button" id="reschedule-button">
            Reschedule
          </button>
          <a href="/" class="btn">Cancel</a>
        </div>
      </form>
    </main>

    <script>
      const formEl = document.getElementById("reschedule-form");
      const buttonEl = document.getElementById("reschedule-button");
      const errorEl = document.getElementById("error-message");

      const submitReschedule = async () => {
        if (!formEl.reportValidity()) return;

        errorEl.hidden = true;

        const formData = new FormData(formEl);
        const response = await fetch(formEl.dataset.apiUrl, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(Object.fromEntries(formData)),
        });

        if (!response.ok) {
          const payload = await response.json().catch(() => ({}));
          errorEl.textContent = payload.error || "Failed to reschedule tasks";
          errorEl.hidden = false;
          return;
        }

        window.location.href = "/";
      };

      formEl.addEventListener("submit", (event) => {
        event.preventDefault();
        submitReschedule();
      });

      buttonEl.addEventListener("click", () => {
        submitReschedule();
      });
    </script>

    <%- include('partials/footer') %>
  </body>
</html>
