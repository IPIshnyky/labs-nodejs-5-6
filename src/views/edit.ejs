<!DOCTYPE html>
<html lang="uk">
  <head>
    <meta charset="UTF-8" />
    <title>Edit Task</title>
    <link rel="stylesheet" href="/css/index.css" />
  </head>
  <body>
    <main>
      <h1>Edit Task</h1>
      <form id="task-form" class="form-card">
        <div class="form-row">
          <label for="title" class="form-label">Title</label>
          <input
            class="form-input"
            type="text"
            id="title"
            name="title"
            autofocus
            required
          />
        </div>

        <div class="form-row">
          <label for="date" class="form-label">Date</label>
          <input
            class="form-input"
            type="date"
            id="date"
            name="date"
            required
          />
        </div>

        <div class="form-row">
          <label for="priority" class="form-label">Priority</label>
          <select class="form-select" id="priority" name="priority">
            <option value="low">Low</option>
            <option value="medium">Medium</option>
            <option value="high">High</option>
          </select>
        </div>

        <div class="form-row">
          <label class="form-label">
            <input type="checkbox" id="completed" name="completed" />
            Completed
          </label>
        </div>

        <div class="form-actions">
          <button class="btn primary" type="submit">Save</button>
          <a href="/" class="btn">Cancel</a>
        </div>
      </form>
    </main>

    <script>
      const taskId = "<%= taskId %>";
      const formEl = document.getElementById("task-form");
      const titleEl = document.getElementById("title");
      const dateEl = document.getElementById("date");
      const priorityEl = document.getElementById("priority");
      const completedEl = document.getElementById("completed");

      const requestJson = async (url, options = {}) => {
        const response = await fetch(url, {
          headers: { "Content-Type": "application/json" },
          ...options,
        });

        if (!response.ok) {
          const payload = await response.json().catch(() => ({}));
          throw new Error(payload.error || "Request failed");
        }

        return response.json();
      };

      const loadTask = async () => {
        const task = await requestJson(`/api/tasks/${taskId}`);
        titleEl.value = task.title;
        dateEl.value = task.date;
        priorityEl.value = task.priority;
        completedEl.checked = task.completed;
        titleEl.focus();
        titleEl.select();
      };

      formEl.addEventListener("submit", async (event) => {
        event.preventDefault();

        try {
          await requestJson(`/api/tasks/${taskId}`, {
            method: "PUT",
            body: JSON.stringify({
              title: titleEl.value,
              date: dateEl.value,
              priority: priorityEl.value,
              completed: completedEl.checked,
            }),
          });

          window.location.href = "/";
        } catch (error) {
          alert(error.message);
        }
      });

      loadTask().catch((error) => {
        alert(error.message);
        window.location.href = "/";
      });
    </script>

    <%- include('partials/footer') %>
  </body>
</html>
